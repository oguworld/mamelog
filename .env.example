# Anthropic APIキー。写真から豆情報を推定する /api/identify で使用する。
# https://console.anthropic.com/ で取得し、このファイルを `.env` にコピーして設定すること。
# 未設定の場合、/api/identify は500エラーを返す(アプリ自体は落ちない。自動入力機能のみ使えない)。
ANTHROPIC_API_KEY=

# ポート。VPS上の既存アプリ(3000=sg-weekend-app/dosuru.app, 3001=willoa.net本体,
# 3010=sg-bus-navi/bus.willoa.net)と衝突しないよう3011を割り当て済み(2026-11-22確認)。
PORT=3011
